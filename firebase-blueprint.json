{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered healthcare citizen or staff user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "asha", "authority"] },
        "preferredLanguage": { "type": "string" },
        "district": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "patientId", "name", "phoneNumber", "role", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Clinical appointment or teleconsultation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "facility": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "patientId", "date", "time", "facility", "status"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Citizen health record, diagnostic report, or clinical encounter note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "doctorOrFacility": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "patientId", "title", "type", "date"]
    },
    "Medicine": {
      "title": "Medicine",
      "description": "Prescribed medicine schedule and dosage reminders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "dosage": { "type": "string" },
        "timing": { "type": "string" },
        "frequency": { "type": "string" },
        "instructions": { "type": "string" }
      },
      "required": ["id", "patientId", "dosage", "frequency"]
    },
    "RecordAccessRequest": {
      "title": "RecordAccessRequest",
      "description": "Patient consent request for doctor medical record access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "ALLOWED", "DENIED"] },
        "requestedOn": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorId", "status", "requestedOn"]
    },
    "FacilityQueue": {
      "title": "FacilityQueue",
      "description": "Public facility queue token status and wait time estimates",
      "type": "object",
      "properties": {
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "currentToken": { "type": "number" },
        "totalTokens": { "type": "number" },
        "avgWaitMins": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["facilityId", "facilityName", "currentToken"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile accounts containing citizen/staff demographic and health profiles."
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Doctor appointments and scheduled consultations."
    },
    "/medicalRecords/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Patient medical records, diagnostic test reports, and clinical notes."
    },
    "/medicines/{medicineId}": {
      "schema": "Medicine",
      "description": "Prescription dosage schedules and active medication reminders."
    },
    "/accessRequests/{requestId}": {
      "schema": "RecordAccessRequest",
      "description": "Patient consent ledger for health record sharing."
    },
    "/queues/{facilityId}": {
      "schema": "FacilityQueue",
      "description": "Public OPD token queue and wait time tracking for healthcare facilities."
    }
  }
}
